# ==============================================================================
# Thesis Vault - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Server HTTP Port (default: 3000)
PORT=3000

# Secret key used for signing JWT authentication tokens (REQUIRED in production)
JWT_SECRET=dev-only-secret-change-me

# Directory for runtime SQLite database and uploaded PDF files (default: ./data)
DATA_DIR=./data

# Optional Frontend Static Directory (default: automatically detects ./frontend)
# PUBLIC_DIR=./frontend

# TLS / HTTPS Configuration (leave blank for plain HTTP or reverse-proxy termination)
TLS_KEY_FILE=
TLS_CERT_FILE=

# Similarity / Plagiarism Detection Service Configuration (FR-021)
# Supported providers: copyleaks (default), mock
PLAGIARISM_PROVIDER=copyleaks
PLAGIARISM_API_URL=
PLAGIARISM_API_KEY=ea2d3061-c76d-4fea-9f62-e91bab1c46ba
PLAGIARISM_EMAIL=
PLAGIARISM_SANDBOX=false
PLAGIARISM_TIMEOUT_MS=25000

# Institutional Digital Object Identifier (DOI) Prefix
DOI_PREFIX=10.5555/lnmiit
